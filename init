## custom init

PATH=$PATH:$HOME/bin
INIT_PATH="${INIT_PATH:-$PATH}"

function main {
  export INIT_FILE="$HOME/bash/init"
  export ENV_FILE="$HOME/.env/all.env"


  [[ -f "$ENV_FILE" ]] && source "$ENV_FILE" || echo "create $ENV_FILE"
  [[ -f "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"


  alias vinit="vim $INIT_FILE && . $INIT_FILE"

  alias dStart="sudo systemctl start docker"
  alias dStop="sudo systemctl disable --now docker.service docker.socket"
  alias suUpd="sudo apt update -y  && sudo apt upgrade -y  && sudo apt autoremove -y"

  alias java11="set_java /usr/lib/jvm/java-1.11.0-openjdk-amd64"
  alias java17="set_java /usr/lib/jvm/java-1.17.0-openjdk-amd64"
  alias java21="set_java /usr/lib/jvm/java-1.21.0-openjdk-amd64"
  alias java26="set_java /usr/lib/jvm/java-1.26.0-openjdk-amd64"
  alias java8="set_java /usr/lib/jvm/java-1.8.0-openjdk-amd64"


  alias ghAuthPetg="gh auth login --with-token --hostname github.com < ~/.env/github_petg.token"

}




### functions
function set_java() {
    export JAVA_HOME="$1"
    export PATH="$JAVA_HOME/bin:$INIT_PATH"
    #. ~/.sdkman/bin/sdkman-init.sh
    java -version
}

main "$@"






